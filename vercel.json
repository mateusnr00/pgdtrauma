{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "admin.pgdtraumatologia.com"
        }
      ],
      "destination": "/pgdtrauma/admin"
    },
    {
      "source": "/login",
      "has": [
        {
          "type": "host",
          "value": "admin.pgdtraumatologia.com"
        }
      ],
      "destination": "/pgdtrauma/admin/login"
    }
  ]
}
